  "cases": [
    {
      "id": "ui-loop",
      "group": "1. The loop works",
      "title": "Click through the whole product in the web app: create, onboard, score, recommend, prompt, reevaluate",
      "kind": "ui-loop"
    },
    {
      "id": "stability",
      "group": "2. Stability",
      "title": "Same unchanged page, scored several times, stays within 2 points",
