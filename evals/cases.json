      "page": "typography-clean.html",
      "minRepeats": 3,
      "maxSpread": 2
    },
    {
      "id": "pair-typography",
      "group": "3. Tells good from bad",
      "title": "Tiny, chaotic type scores lower than the clean twin",
      "kind": "pair",
      "bad": "typography-bad.html",
      "good": "typography-clean.html",
      "lowerOn": ["TYPOGRAPHY"]
    },
    {
      "id": "pair-contrast",
      "group": "3. Tells good from bad",
      "title": "Washed-out low-contrast page fails the contrast deal-breaker; clean twin passes",
      "kind": "pair",
      "bad": "contrast-bad.html",
      "good": "contrast-clean.html",
      "dealBreakerFails": ["BODY_CONTRAST"]
    },
    {
      "id": "pair-clutter",
      "group": "3. Tells good from bad",
      "title": "Cluttered everything-at-once page scores lower on hierarchy and density",
      "kind": "pair",
      "bad": "clutter-bad.html",
      "good": "clutter-clean.html",
      "lowerOn": ["HIER", "DENSITY"]
    },
    {
      "id": "improve-demo",
      "group": "4. The loop improves a site",
      "title": "Built-in demo: baseline vs fixed version, mobile overflow and small type get better",
      "kind": "improve-demo"
    },
    {
      "id": "mobile-only",
      "group": "6. Mobile only",
      "title": "Page that only breaks on phones scores lower on mobile than desktop",
      "kind": "mobile-only",
      "page": "mobile-break.html"
    },
    {
      "id": "honest-unreachable",
      "group": "7. Honest failures",
      "title": "Unreachable URL fails clearly, with no invented scores",
