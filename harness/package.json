{
  "name": "better",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "npm run build && node --experimental-strip-types tests/e2e.ts",
    "test:ui": "npm run build && node --experimental-strip-types tests/ui.ts",
    "test:benchmark": "node --experimental-strip-types tests/benchmark.ts",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "express": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
